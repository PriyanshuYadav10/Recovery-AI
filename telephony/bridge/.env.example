# Recovery AI telephony bridge - copy to .env and fill in. Never commit .env.
PORT=3100

# Public HTTPS URL Twilio can reach (ngrok http 3100).
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev

# Where the FastAPI brain is listening.
RECOVERY_API_URL=http://127.0.0.1:8000

# VOICE_PIPELINE=gather  -> Twilio's own ASR + TTS. Only a Twilio account needed.
# VOICE_PIPELINE=stream  -> media streams with real barge-in, using the
#                           STT/TTS providers configured below.
VOICE_PIPELINE=gather

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Where a warm handoff is transferred to. Leave blank to queue in the Agent
# Inbox without moving the live call.
HUMAN_QUEUE_NUMBER=

# ---- stream pipeline audio -------------------------------------------------
# Groq is the default for both, because the brain already needs a Groq key.
# STT_PROVIDER: groq | deepgram        TTS_PROVIDER: groq | elevenlabs
STT_PROVIDER=groq
TTS_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Orpheus needs one-time terms acceptance at console.groq.com before it speaks.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=tara

# Only needed if you switch a provider away from Groq.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Endpointing: when the bridge decides the caller has finished speaking.
VAD_THRESHOLD=900
VAD_SILENCE_MS=700

# Twilio answering-machine detection
TWILIO_MACHINE_DETECTION=Enable
TWILIO_AMD_TIMEOUT=30

# Record the call leg (the disclosure already tells the customer).
TWILIO_RECORD=true
