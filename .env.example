# Recovery AI - copy to .env. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
HOST=0.0.0.0
PORT=8000

# Journey completion endpoint. Defaults to the built-in sandbox; point this at
# CIMET's sandbox and the submit client switches to a real HTTP POST.
# JOURNEY_SUBMIT_URL=https://sandbox.cimet.example/api/journeys/complete
# JOURNEY_SUBMIT_TOKEN=

# Telephony bridge (telephony/bridge) for real phone calls.
# BRIDGE_BASE_URL=http://127.0.0.1:3100
# HUMAN_QUEUE_NUMBER=+61400000000
